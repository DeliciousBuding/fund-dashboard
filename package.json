{
  "name": "fund-dashboard-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test:unit": "bash scripts/test-unit.sh",
    "test:go": "go test ./... -count=1",
    "test:cover": "bash scripts/test-cover.sh",
    "vet:go": "go vet ./...",
    "build:go": "go build -o bin/fund-dashboard ./cmd/fund-dashboard",
    "seed:ci": "bash scripts/seed-ci-db.sh",
    "dev:web": "pnpm -C web dev",
    "build:web": "pnpm -C web build",
    "test:web": "pnpm -C web test",
    "check:web": "biome check . && pnpm -C web exec tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.62.1"
  }
}
