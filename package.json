{
  "name": "fund-dashboard-monorepo",
  "private": true,
  "workspaces": [
    "packages/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace packages/web",
    "build": "npm run build --workspace packages/web",
    "test": "cd packages/web && npx vitest run",
    "test:unit": "bash scripts/test-unit.sh",
    "test:go": "go test ./... -count=1",
    "test:cover": "bash scripts/test-cover.sh",
    "vet:go": "go vet ./...",
    "build:go": "go build -o bin/fund-dashboard ./cmd/fund-dashboard",
    "seed:ci": "bash scripts/seed-ci-db.sh",
    "release:package": "bash scripts/package-release.sh"
  }
}
