{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fund-dashboard.local/contracts/tool-registry.schema.json",
  "title": "ToolRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "tools"],
  "properties": {
    "schema_version": {
      "const": "tool-registry-v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tools": {
      "type": "array",
      "minItems": 44,
      "items": { "$ref": "#/$defs/tool_definition" }
    }
  },
  "$defs": {
    "tool_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "description",
        "input_schema",
        "output_envelope",
        "capability",
        "confirmation",
        "audit",
        "mcp_annotations"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "category": {
          "enum": ["query", "portfolio", "transactions", "admin", "operations", "securities", "market", "analysis", "report", "dca"]
        },
        "description": { "type": "string" },
        "input_schema": { "type": "object" },
        "output_envelope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "json_root"],
          "properties": {
            "kind": { "enum": ["json", "text", "stream"] },
            "json_root": { "type": ["string", "null"] }
          }
        },
        "capability": { "$ref": "#/$defs/tool_capability" },
        "confirmation": { "$ref": "#/$defs/confirmation_policy" },
        "audit": { "$ref": "#/$defs/audit_policy" },
        "mcp_annotations": { "$ref": "#/$defs/mcp_annotations" },
        "migration": { "$ref": "#/$defs/migration_metadata" }
      }
    },
    "tool_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "scope", "permission", "risk_level", "use_for"],
      "properties": {
        "tool": { "type": "string" },
        "scope": { "enum": ["read", "write", "maintenance", "external_context", "disabled"] },
        "permission": { "enum": ["allowed", "requires_confirmation", "disabled"] },
        "risk_level": { "enum": ["low", "medium", "high"] },
        "use_for": { "type": "string" }
      }
    },
    "confirmation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason", "token_ttl_seconds"],
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "token_ttl_seconds": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "audit_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "record_attempt", "record_result", "redact_args"],
      "properties": {
        "event_type": {
          "enum": ["read", "maintenance", "write", "external_context", "disabled"]
        },
        "record_attempt": { "type": "boolean" },
        "record_result": { "type": "boolean" },
        "redact_args": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "mcp_annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only_hint", "destructive_hint", "open_world_hint"],
      "properties": {
        "read_only_hint": { "type": "boolean" },
        "destructive_hint": { "type": "boolean" },
        "open_world_hint": { "type": "boolean" }
      }
    },
    "migration_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file", "permission_source", "review_required"],
      "properties": {
        "source_file": { "type": "string" },
        "permission_source": { "enum": ["harness", "inferred"] },
        "review_required": { "type": "boolean" }
      }
    }
  }
}
