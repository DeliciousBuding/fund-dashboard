* text=auto

.gitattributes text eol=lf
*.sh text eol=lf
deploy/*.sh text eol=lf
scripts/*.sh text eol=lf

*.ps1 text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.go text eol=lf
*.example text eol=lf

# Windows autocrlf 会把工作副本转 CRLF；biome 对该文件按 LF 校验，强制 LF 保持本地/CI 一致。
web/public/manifest.webmanifest text eol=lf

# 其余文本类型显式 LF：防止 Windows autocrlf 把工作副本转 CRLF 导致本地 gofmt/biome 与 CI 不一致。
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.sql text eol=lf
*.patch text eol=lf
*.toml text eol=lf

# 无扩展名文本文件显式 LF（text=auto + autocrlf 会警告 CRLF 转换）。
.gitattributes text eol=lf
.dockerignore text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
SECURITY.md text eol=lf
go.mod text eol=lf
go.sum text eol=lf
