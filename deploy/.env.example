# fund-dashboard — 复制为 .env 并填写。.env 永不入库（.gitignore 已挡）。

# ── 必填（production 强制 ≥16 字符非占位）────────────────────────────
# MCP operator key，同时是 /api/admin/* 的 Bearer。生成：openssl rand -hex 32
MCP_API_KEY=

# ── Web 登录（单租户）───────────────────────────────────────────────
# 不设置：首次访问进入 /setup 页面设置密码（argon2id 哈希入库）。
# IaC 预置：FUND_AUTH_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=2$<salt>$<key>
# 注意：env 模式下「修改密码」端点禁用（403 auth_env_managed）。
# FUND_AUTH_PASSWORD_HASH=

# 会话窗口：滑动 720h（30d），绝对上限 2160h（90d）。
# FUND_AUTH_SESSION_TTL=720h
# FUND_AUTH_SESSION_MAX_AGE=2160h
# 纯 HTTP 局域网部署（无 TLS 无 localhost）才需要关闭：
# FUND_AUTH_SECURE_COOKIE=false

# ── 兼容层：edge 注入的浏览器写 key ─────────────────────────────────
# 旧部署（edge proxy 注入 X-Fund-Edge-Key）保留；新部署可整体关闭：
# FUND_EDGE_AUTH_ENABLED=false
FUND_EDGE_KEY=

# 浏览器变更请求的 Origin 白名单（逗号分隔；localhost 任意端口恒放行）。
# FUND_ALLOWED_ORIGINS=https://fund.example.com

# ── 可选 ────────────────────────────────────────────────────────────
# 只读 analyst MCP key（不得与 MCP_API_KEY 相同）：
# PUBLIC_MCP_KEY=
# AgentOps 写确认（MCP 写工具的 confirmation 流）：
# FUND_AGENT_OPS_ENABLED=true
# FUND_AGENT_CONFIRMATION_SECRET=   # openssl rand -hex 32

# 生产模式开关：强制强密钥校验。
FUND_ENV=production
# 端口映射（compose）：FUND_PORT=8765
